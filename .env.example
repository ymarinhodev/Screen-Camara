# Neon (PostgreSQL) - copie a "Connection string" do painel do Neon
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Chave para assinar o cookie de login (mínimo 32 caracteres aleatórios)
SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria-com-32-ou-mais-caracteres

# Primeiro acesso da equipe (usados apenas pelo setup.php)
ADMIN_NOME=comunicacao
ADMIN_EMAIL=comunicacao@camara-alvorada.rs.gov.br
ADMIN_SENHA=defina-uma-senha-forte

# Token para liberar o setup.php (remova esta variável depois do primeiro uso)
SETUP_TOKEN=troque-por-um-token-secreto
